# WebSocket endpoint used by the Agent to connect to the Remote Administration Server.
# Use wss:// in production. The built-in default is ws://localhost:8081/ws.
WS_SERVER_URL=ws://127.0.0.1:8081/ws

# Development only: permit file download URLs using HTTP when the URL host is
# localhost or a loopback IP (127.0.0.0/8 or ::1). Keep this false in production.
ALLOW_LOCAL_HTTP_DOWNLOADS=true

# Directory where verified files are stored. Downloads are first written as
# <filename>.part in this directory and renamed after size/SHA-256 verification.
# Relative paths are resolved from the Agent's current working directory.
DOWNLOAD_DIRECTORY=./data/downloads

# Maximum number of HTTP file downloads that may run at the same time.
# Must be a positive integer. The built-in default is 2.
MAX_CONCURRENT_DOWNLOADS=2

# Maximum number of download jobs waiting for an available worker.
# Must be a positive integer. The built-in default is 16.
DOWNLOAD_QUEUE_SIZE=16

# Maximum accepted file size in bytes. Commands exceeding this limit are rejected.
# 10737418240 bytes = 10 GiB, which is also the built-in default.
MAX_DOWNLOAD_SIZE_BYTES=10737418240


# • สร้างไฟล์ .env.example แล้ว โดยโปรเจกต์ใช้ environment variables ทั้งหมด 5 ตัว:

#   - WS_SERVER_URL — URL ของ WebSocket Server ควรใช้ wss:// บน production ค่าเริ่มต้นคือ
#     ws://localhost:8081/ws

#   - DOWNLOAD_DIRECTORY — directory สำหรับเก็บไฟล์ที่ดาวน์โหลดและ .part ค่าเริ่มต้นคือ data/downloads
#   - MAX_CONCURRENT_DOWNLOADS — จำนวน download ที่ทำงานพร้อมกัน ค่าเริ่มต้น 2
#   - DOWNLOAD_QUEUE_SIZE — จำนวนงานสูงสุดที่รอในคิว ค่าเริ่มต้น 16
#   - MAX_DOWNLOAD_SIZE_BYTES — ขนาดไฟล์สูงสุดที่ Agent ยอมรับ หน่วย bytes ค่าเริ่มต้น 10 GiB

#   ข้อควรทราบ: ตอนนี้โปรเจกต์อ่านค่าจาก environment ของ process โดยตรงผ่าน os.Getenv
#   และยังไม่ได้โหลดไฟล์ .env อัตโนมัติ ดังนั้นต้องกำหนดตัวแปรก่อนรัน เช่น PowerShell:

#   $env:WS_SERVER_URL = "wss://server.example.com/ws"
#   $env:DOWNLOAD_DIRECTORY = ".\data\downloads"
#   $env:MAX_CONCURRENT_DOWNLOADS = "2"
#   $env:DOWNLOAD_QUEUE_SIZE = "16"
#   $env:MAX_DOWNLOAD_SIZE_BYTES = "10737418240"

#   go run .

#   หรือให้ระบบ deployment เช่น Docker Compose, systemd หรือ CI/CD อ่าน .env และส่งค่าเหล่านี้เข้า process
#   ครับ
