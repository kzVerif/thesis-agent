# Explicit localhost development, including development Service installations.
# Production: set production and configure HTTPS/WSS URLs before deploying.
# If omitted: console defaults to development; Service/provision defaults to production.
TRANSPORT_MODE=development

# WebSocket endpoint used by the Agent to connect to the Remote Administration Server.
# Use wss:// in production. The built-in default is ws://localhost:8081/ws.
WS_SERVER_URL=ws://localhost:8081/ws

# HTTP API base URL used for first-time Agent enrollment.
AGENT_API_URL=http://localhost:8080

# Optional path for Agent diagnostic/security handoff logs.
AGENT_LOG_PATH=./logs/agent.log

# Development only: permit file download URLs using HTTP when the URL host is
# localhost or a loopback IP (127.0.0.0/8 or ::1). Keep this false in production.
ALLOW_LOCAL_HTTP_DOWNLOADS=false

# Directory where verified files are stored. Downloads are first written as
# <filename>.part in this directory and renamed after size/SHA-256 verification.
# Relative paths resolve under the console or Service runtime root.
DOWNLOAD_DIRECTORY=./data/downloads

# Maximum number of HTTP file downloads that may run at the same time.
# Must be a positive integer. The built-in default is 2.
MAX_CONCURRENT_DOWNLOADS=2

# Maximum number of download jobs waiting for an available worker.
# Must be a positive integer. The built-in default is 16.
DOWNLOAD_QUEUE_SIZE=16

# Maximum accepted file size in bytes. Commands exceeding this limit are rejected.
# 10737418240 bytes = 10 GiB, which is also the built-in default.
MAX_DOWNLOAD_SIZE_BYTES=10737418240

# Temporary troubleshooting only. Logs the registration HTTP status and up to
# 16 KiB of the server response. Remove or set false after debugging.
AGENT_DEBUG_REGISTER_RESPONSE=false


# Console loads .env from its working directory without replacing existing
# process environment variables. Service/provisioning loads the .env under
# %ProgramData%\ThesisAgentDev; use scripts/dev-service.ps1 to configure it.
# Relative runtime paths resolve under the selected runtime root: the console
# working directory or the Service's ProgramData directory.
# Never store enrollment tokens or private keys in this template.
